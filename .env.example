# PrepPilot Environment Configuration

# Next.js Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database Connection (Default is SQLite for zero-config local run; for PostgreSQL use: postgresql://postgres:postgrespassword@localhost:5432/preppilot?schema=public)
DATABASE_URL="file:./dev.db"

# NextAuth Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="preppilot-ultra-secure-auth-secret-key-change-in-prod-32chars"

# Google OAuth (Optional: leave empty to use credentials/demo login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Provider Configuration (Google Gemini)
# Obtain your free API key at https://aistudio.google.com
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# System Feature Flags
ENABLE_MOCK_AI_FALLBACK="true"
ENABLE_VOICE_MODE="true"
